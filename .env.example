# Set to 'true' to enable interactive Pre-Sale Checkout Popup & Midtrans Payment
# Set to 'false' (or leave empty) for Production release right now (Visual Banner Only - Option C)
VITE_ENABLE_CHECKOUT=false

# Midtrans Credentials (Set in Vercel Environment Variables or local .env)
# VITE_MIDTRANS_CLIENT_KEY=your_client_key_here
# MIDTRANS_SERVER_KEY=your_server_key_here
